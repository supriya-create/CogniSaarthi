// ============================================================
// COGNISAARTHI — DATA MODEL (Phase 1)
// ------------------------------------------------------------
// Design notes on extensibility:
//
//  * `Game` is a seeded TABLE, not a hardcoded list. Adding a
//    future game means inserting a row and registering one
//    component — no schema or application rewrite.
//  * `GameResult.rawRounds` stores per-round telemetry as JSON.
//    Phase 2's personalisation engine needs round-level detail
//    that a fixed column set cannot anticipate.
//  * `GameSession.clientSessionId` is a nullable unique key so a
//    session can be written idempotently. This is what future
//    offline-first replay will use to avoid duplicate rows.
//  * `CaregiverLink` is a join model, not a foreign key on User,
//    so one caregiver can follow several people and one person
//    can have several caregivers.
//  * Reminders, personal memories, voice sessions and cognitive
//    trends are deliberately NOT modelled yet. Empty unused
//    tables are scaffolding, not architecture. They attach to
//    `User` when their features are actually built.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------- enums ----------------------------

enum Language {
  EN
  HI
  AS
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum CognitiveDomain {
  SHORT_TERM_MEMORY
  ATTENTION
  WORKING_MEMORY
  LANGUAGE
  PROCESSING_SPEED
  EXECUTIVE_FUNCTION
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum FontScale {
  COMFORTABLE
  LARGE
  EXTRA_LARGE
}

enum SpeechRate {
  SLOW
  NORMAL
}

/// Phase 3 personal memory bank. A memory is one card the caregiver
/// curates on the elder's behalf — a person, a place, a familiar
/// thing, or a moment.
enum MemoryCategory {
  PERSON
  PLACE
  THING
  MOMENT
}

enum LinkStatus {
  PENDING
  ACTIVE
  REVOKED
}

// -------------------- Phase 4: reminders & alerts --------------------

/// The kind of reminder, chosen by the caregiver. Only ever a label —
/// nothing here is treated as clinical, and the copy shown for a
/// MEDICATION reminder is neutral ("Medication reminder", never "take
/// your medicine").
enum ReminderCategory {
  MEDICATION
  APPOINTMENT
  DAILY_ROUTINE
  COGNITIVE_ACTIVITY
  FAMILY
  OTHER
}

/// How a reminder repeats. Deliberately small — a wall-clock time plus
/// one of these four patterns covers a daily routine without a general
/// scheduling engine. WEEKLY carries a weekday set, so "every Monday"
/// and "Mon–Fri" are both WEEKLY with different `weekdays`.
enum RecurrenceType {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
}

/// Two levels only. IMPORTANT reminders may raise a caregiver alert
/// when missed; NORMAL ones do not. Nothing is ever "critical".
enum ReminderPriority {
  NORMAL
  IMPORTANT
}

/// The lifecycle of one materialised reminder occurrence. A medication
/// reminder marked DONE means "acknowledged", never "medication taken"
/// — the app cannot know that and never claims it.
enum ReminderLogStatus {
  PENDING
  DONE
  SKIPPED
  SNOOZED
  MISSED
}

/// Alert importance, for the caregiver. Three calm levels; normal
/// performance changes are ATTENTION at most, never "critical".
enum AlertSeverity {
  INFO
  ATTENTION
  IMPORTANT
}

/// What produced an alert. Each maps to neutral, non-medical copy.
enum AlertType {
  REMINDER_MISSED
  INACTIVITY
  PERFORMANCE_CHANGE
  ACTIVITY_DIFFICULTY
  REMINDER_UPCOMING
  DAILY_COMPLETE
}

/// Alert resolution state. DISMISSED and RESOLVED are kept rather than
/// deleted, so the audit trail survives a caregiver tidying their list.
enum AlertStatus {
  UNREAD
  READ
  RESOLVED
  DISMISSED
}

// -------------------- Phase 7: consent & audit --------------------

/// What a person is being asked to agree to. One value today, because
/// one purpose is all that is actually offered — a purpose the product
/// does not serve must not appear on a consent form.
///
/// Deliberately NOT "medical research": Cognisaarthi runs no study and
/// makes no clinical claim. The purpose is improving the product and
/// understanding, in aggregate, how the activities are used.
enum ConsentPurpose {
  RESEARCH_IMPROVEMENT
}

/// Sensitive operations worth being able to answer questions about
/// later. Deliberately a small, closed list: an audit log that records
/// everything records nothing usefully.
enum AuditAction {
  RESEARCH_CONSENT_GRANTED
  RESEARCH_CONSENT_WITHDRAWN
  RESEARCH_EXPORT_GENERATED
  CAREGIVER_SNAPSHOT_ISSUED
  ACCOUNT_DATA_EXPORTED
  ACCOUNT_DATA_DELETED
  CAREGIVER_LINK_CHANGED
}

/// Optional soft category for a caregiver's free-text observation.
/// Never converted into a medical conclusion.
enum NoteCategory {
  GENERAL
  MOOD
  ACTIVITY
  SLEEP
  APPETITE
  OTHER
}

// ---------------------------- people ----------------------------

/// An elderly user. Intentionally minimal: onboarding asks for a
/// name and a language, nothing more.
model User {
  id       String   @id @default(cuid())
  name     String
  avatarId String   @default("marigold")
  language Language @default(EN)

  /// Short, readable code shown on the elder's profile. A caregiver
  /// types it in to request a link. Chosen over emailing an invite
  /// because the elder may not have email, but can read a code aloud.
  connectCode String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preference     UserPreference?
  sessions       GameSession[]
  caregiverLinks CaregiverLink[]
  memories       PersonalMemory[]

  // Phase 4
  reminders         Reminder[]
  reminderLogs      ReminderLog[]
  notes             CaregiverNote[]
  alerts            Alert[]
  emergencyContacts EmergencyContact[]

  // Phase 7
  researchConsents ResearchConsent[]

  @@index([createdAt])
}

/// Accessibility and gameplay preferences, kept separate from
/// identity so the settings surface can grow independently.
model UserPreference {
  id                  String     @id @default(cuid())
  userId              String     @unique
  language            Language   @default(EN)
  fontScale           FontScale  @default(COMFORTABLE)
  highContrast        Boolean    @default(false)
  reduceMotion        Boolean    @default(false)
  soundEnabled        Boolean    @default(true)
  preferredDifficulty Difficulty @default(EASY)

  // Phase 3 voice assistance. Folded in here rather than a separate
  // VoicePreference table — these are a handful of settings on the
  // same 1-1 record, and a new table would be over-normalisation.
  voiceEnabled         Boolean    @default(false)
  autoReadInstructions Boolean    @default(false)
  speechRate           SpeechRate @default(NORMAL)

  // Phase 4 — the timezone reminders are scheduled in. Reminders store
  // a wall-clock time and are materialised into instants against this
  // zone, so "08:00 medication" stays at 08:00 local. Defaults to the
  // app's home region; a caregiver can correct it.
  timeZone String @default("Asia/Kolkata")

  // Phase 4 — elder notification experience. All calm by default;
  // spoken reminders additionally require voiceEnabled.
  reminderVoice     Boolean @default(true) // speak a reminder aloud
  autoReadReminders Boolean @default(false) // read the reminder text without a tap
  notificationSound Boolean @default(true)

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A curated personal memory shown to one elder. Created and owned by
/// a caregiver linked to that elder; the elder only ever sees the
/// ones marked enabled. Images are stored outside the web root and
/// served through an authenticated route (see /api/memories image).
model PersonalMemory {
  id           String         @id @default(cuid())
  userId       String // the elder this memory belongs to
  caregiverId  String // the caregiver who added it
  category     MemoryCategory
  title        String // e.g. a person's name, a place name
  relationship String? // e.g. "Daughter" — for PERSON cards
  description  String? // a short, gentle note

  /// Path to the stored image on disk, relative to the private
  /// storage root. Never a public URL. Null when there is no photo.
  imagePath String?

  /// Whether this memory may be used in personal recall activities.
  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  caregiver Caregiver @relation(fields: [caregiverId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
  @@index([caregiverId])
}

/// A family member or care worker. Unlike the elderly user, a
/// caregiver authenticates with an email and password.
model Caregiver {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  links      CaregiverLink[]
  memories   PersonalMemory[]
  reminders  Reminder[]
  notes      CaregiverNote[]
  preference CaregiverPreference?
}

/// Many-to-many relationship carrying its own metadata.
model CaregiverLink {
  id           String     @id @default(cuid())
  caregiverId  String
  userId       String
  relationship String     @default("Family member")
  status       LinkStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())

  caregiver Caregiver @relation(fields: [caregiverId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([caregiverId, userId])
  @@index([userId])
}

// ---------------------------- games ----------------------------

/// Catalogue row for a cognitive activity. The `id` is a stable
/// slug that matches the key in lib/game-engine/registry.ts.
model Game {
  id               String          @id
  name             String
  domain           CognitiveDomain
  shortDescription String
  instructions     String
  iconKey          String
  isActive         Boolean         @default(true)
  sortOrder        Int             @default(0)
  createdAt        DateTime        @default(now())

  sessions GameSession[]

  @@index([isActive, sortOrder])
}

/// One playthrough. Created when the activity starts and closed
/// when it finishes, so abandoned attempts are visible too.
model GameSession {
  id         String        @id @default(cuid())
  userId     String
  gameId     String
  difficulty Difficulty
  language   Language      @default(EN)
  status     SessionStatus @default(IN_PROGRESS)

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int?

  roundsTotal     Int @default(0)
  roundsCompleted Int @default(0)

  /// Idempotency key supplied by the client. Reserved for the
  /// future offline queue; unique so a replayed write is a no-op.
  clientSessionId String? @unique

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  game   Game        @relation(fields: [gameId], references: [id])
  result GameResult?

  @@index([userId, startedAt])
  @@index([userId, status])
}

/// The scored outcome of a completed session.
model GameResult {
  id        String @id @default(cuid())
  sessionId String @unique

  score          Int // 0-100
  accuracy       Float // 0-1
  stars          Int // 0-5, presentation only
  correctCount   Int   @default(0)
  incorrectCount Int   @default(0)
  mistakes       Int   @default(0)
  hints          Int   @default(0)

  totalResponseTimeMs Int @default(0)
  avgResponseTimeMs   Int @default(0)

  /// Per-round detail, shape defined by each game's engine module.
  rawRounds Json?

  createdAt DateTime @default(now())

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// -------------------- Phase 4: reminders --------------------

/// A reminder DEFINITION: what to remind about and when it repeats.
/// The actual dated events live in `ReminderLog`, so history is kept
/// even after a definition changes. Created by a caregiver for the
/// elder they are linked to.
///
/// Timezone: `timeMinutes` is a wall-clock time (minutes past local
/// midnight) in the owner's `UserPreference.timeZone`. Occurrences are
/// materialised into UTC instants against that zone (see
/// lib/reminders/recurrence.ts), never assumed to be UTC or server
/// time.
model Reminder {
  id          String  @id @default(cuid())
  userId      String // the elder this reminder is for
  caregiverId String? // the caregiver who created it; null if system-made

  title       String
  description String?
  category    ReminderCategory @default(OTHER)
  priority    ReminderPriority @default(NORMAL)

  /// Minutes past local midnight, 0–1439.
  timeMinutes Int
  recurrence  RecurrenceType @default(ONCE)
  /// For WEEKLY: weekdays that fire, 0 (Sunday) … 6 (Saturday).
  weekdays    Int[]          @default([])
  /// For MONTHLY: day of month, 1–31 (clamped to the month's length).
  monthDay    Int?
  /// Local calendar day the schedule begins (and the exact day for ONCE).
  startDate   DateTime
  /// Optional last local calendar day a recurring reminder fires.
  endDate     DateTime?

  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  caregiver Caregiver?    @relation(fields: [caregiverId], references: [id], onDelete: SetNull)
  logs      ReminderLog[]

  @@index([userId, enabled])
  @@index([caregiverId])
}

/// One dated occurrence of a reminder and how it was answered. Separated
/// from the definition so reporting has real events to count, and so a
/// reminder edited today does not rewrite yesterday. Materialised lazily
/// (no cron): opening a reminder view syncs the occurrences due so far.
model ReminderLog {
  id             String            @id @default(cuid())
  reminderId     String
  userId         String // denormalised for per-elder indexing
  /// The exact UTC instant this occurrence was scheduled for.
  scheduledFor   DateTime
  status         ReminderLogStatus @default(PENDING)
  acknowledgedAt DateTime?
  /// When SNOOZED ("remind me later"), when to surface it again.
  snoozedUntil   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reminderId, scheduledFor])
  @@index([userId, scheduledFor])
  @@index([userId, status])
}

/// A caregiver's free-text observation about the elder. Kept as written;
/// never parsed into a medical conclusion.
model CaregiverNote {
  id          String       @id @default(cuid())
  userId      String
  caregiverId String
  date        DateTime     @default(now())
  body        String
  category    NoteCategory @default(GENERAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  caregiver Caregiver @relation(fields: [caregiverId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([caregiverId])
}

/// A meaningful, de-duplicated signal for the caregiver. `dedupeKey`
/// makes each condition unique per elder, so the same missed morning is
/// one alert, not a stream. Dismissed/resolved alerts are retained.
model Alert {
  id        String        @id @default(cuid())
  userId    String
  type      AlertType
  severity  AlertSeverity @default(INFO)
  title     String
  body      String
  status    AlertStatus   @default(UNREAD)
  /// Stable identity for a condition, e.g. "missed:<date>" — enforced
  /// unique per elder so signal never becomes noise.
  dedupeKey String

  createdAt             DateTime  @default(now())
  readAt                DateTime?
  resolvedAt            DateTime?
  resolvedByCaregiverId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, status])
  @@index([userId, createdAt])
}

/// An emergency contact the elder can reach with one tap. This is a
/// contact card and a call/dial action only — Cognisaarthi never claims
/// to have contacted anyone or dispatched help.
model EmergencyContact {
  id           String @id @default(cuid())
  userId       String
  name         String
  phone        String
  relationship String @default("Family member")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// -------------------- Phase 7: consent & audit --------------------

/// One person's decision about ONE VERSION of ONE purpose.
///
/// Versioned rather than a boolean on `User` because consent is only
/// meaningful in relation to what was actually said at the time. If the
/// explanation changes materially it becomes a new version, a new row,
/// and an unanswered question — never an old "yes" silently carried
/// forward onto new wording.
///
/// A withdrawn row is kept (`consented = false`, `withdrawnAt` set)
/// rather than deleted, so "they used to consent and then withdrew" is
/// distinguishable from "they were never asked".
///
/// Only the ELDER may create one of these. A caregiver link is a care
/// relationship, not legal authority — see docs/privacy-and-consent.md.
model ResearchConsent {
  id      String         @id @default(cuid())
  userId  String
  /// e.g. "research-consent-v1" — matches a version in lib/privacy/consent.ts.
  version String
  purpose ConsentPurpose @default(RESEARCH_IMPROVEMENT)

  /// The current answer for this version. False means either declined
  /// or withdrawn; `withdrawnAt` tells the two apart.
  consented   Boolean
  consentedAt DateTime?
  withdrawnAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
  @@index([userId])
}

/// A minimal record that a sensitive thing happened.
///
/// Note there are NO foreign keys here, which is deliberate: an audit
/// entry that is cascade-deleted along with the account it describes
/// cannot answer the one question an audit log exists to answer. Ids
/// are stored as plain strings and may outlive their rows.
///
/// `detail` carries small structured context — counts, a consent
/// version, a record total. It must never carry the CONTENT of anything
/// (no memory text, no note bodies, no tokens, no credentials).
model AuditEvent {
  id     String      @id @default(cuid())
  action AuditAction

  /// The elder the event concerns, when there is one.
  userId String?
  /// The caregiver who acted, when a caregiver acted.
  caregiverId String?
  /// Free-form, deliberately small, non-sensitive context.
  detail Json?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

/// Caregiver-side notification preferences. In-app is the only delivery
/// channel in Phase 4; these gate what a caregiver is shown, and are the
/// seam future channels (push, email) would read.
model CaregiverPreference {
  id          String @id @default(cuid())
  caregiverId String @unique

  reminderNotifications      Boolean @default(true)
  cognitiveActivityReminders Boolean @default(true)
  alertNotifications         Boolean @default(true)
  weeklySummary              Boolean @default(true)

  updatedAt DateTime @updatedAt

  caregiver Caregiver @relation(fields: [caregiverId], references: [id], onDelete: Cascade)
}

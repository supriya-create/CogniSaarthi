DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cognisaarthi?schema=public"
AUTH_SECRET="generate-with: openssl rand -hex 32"

# Phase 7 — used to derive pseudonymous research participant ids.
#
# Deliberately SEPARATE from AUTH_SECRET: rotating session signing must not
# silently re-pseudonymise a research cohort, and a leaked session secret must
# not hand over the identity mapping.
#
# Optional. If it is unset or shorter than 32 characters, research export is
# disabled and refuses to run — there is no fallback, because a fallback would
# produce ids that look pseudonymous and are not. Everything else in the app
# works without it.
RESEARCH_EXPORT_SECRET="generate-with: openssl rand -hex 32"
